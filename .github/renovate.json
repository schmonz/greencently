{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "packageRules": [
    {
      "matchPackagePatterns": [
        "^org\\.junit\\.platform:"
      ],
      "allowedVersions": "<1.11.0"
    },
    {
      "matchPackagePatterns": [
        "^org\\.junit($|\\.)"
      ],
      "excludePackagePatterns": [
        "^org\\.junit\\.platform:"
      ],
      "allowedVersions": "<5.11.0"
    }
  ]
}
